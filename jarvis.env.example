# Copy to jarvis.env (gitignored) and fill in your real values.
ROOM_USER=youruser
ROOM_HOST=your-room-pi.local      # room Pi hostname or LAN IP
ROOM_KEY=/home/you/.ssh/id_room
PC_USER=youruser
PC_HOST=your-pc.local             # PC hostname / VPN IP
PC_KEY=/home/you/.ssh/id_pc
PC_MAC=AA:BB:CC:DD:EE:FF          # PC NIC MAC for Wake-on-LAN
LAN_BROADCAST=your.lan.broadcast  # e.g. x.x.x.255
